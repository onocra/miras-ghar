/* MIRĀS GHĀR | Social contact icons — V3, 2026-11-03
   GitHub destination: assets/mg/social-links.js

   Every icon image is loaded from the exact filenames supplied by the owner.
   IMPORTANT: 'instragram-logo.png' retains the supplied spelling.
   Profiles not yet created have no external link. Clicking one displays
   an honest 'coming soon' status message, rather than opening a false URL.
   To activate an account later: put the complete https:// profile URL in
   the corresponding field in SOCIAL_URLS below, and commit this ONE file.
*/
(() => {
  'use strict';

  // If your files are physically in GitHub's /assets/ folder rather than
  // /assets/mg/, change only this one value to '/assets/'.
  const LOGO_BASE = '/assets/';
  const LOGO_FALLBACK = '/assets/mg/';

  const SOCIAL_URLS = {
    whatsapp: 'https://wa.me/923192844710',
    facebook: 'https://www.facebook.com/profile.php?id=61596364314205',
    x: '',
    youtube: '',
    pinterest: '',
    instagram: '',
    tiktok: ''
  };

  const CHANNELS = [
    {id:'whatsapp',  label:'WhatsApp',  filename:'whatsapp-logo.png'},
    {id:'facebook',  label:'Facebook',  filename:'facebook-logo.png'},
    {id:'x',         label:'X',         filename:'x-logo.png'},
    {id:'youtube',   label:'YouTube',   filename:'youtube-logo.png'},
    {id:'pinterest', label:'Pinterest', filename:'pinterest-logo.png'},
    {id:'instagram', label:'Instagram', filename:'instragram-logo.png'},
    {id:'tiktok',    label:'TikTok',    filename:'tiktok-logo.png'}
  ];

  const css = `
  .mg-social-footer{display:flex;flex-direction:column;align-items:flex-start;gap:9px;margin-top:16px;padding-top:13px;border-top:1px solid rgba(218,181,116,.38)}
  .mg-social-footer-label{font:700 10px/1.4 Arial,sans-serif;letter-spacing:.19em;text-transform:uppercase;color:#e5cd9b}
  .mg-social-row{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
  .mg-social-icon{width:41px;height:41px;display:inline-flex;align-items:center;justify-content:center;padding:3px;margin:0;border-radius:13px;border:1px solid rgba(219,188,122,.38);background:rgba(251,229,178,.08);box-shadow:0 3px 10px rgba(10,22,15,.14);text-decoration:none!important;color:#f1dbb2;cursor:pointer;transition:transform .2s ease,background .2s ease;flex:none}
  .mg-social-icon img{display:block;width:100%;height:100%;object-fit:contain;pointer-events:none}
  a.mg-social-icon:hover,button.mg-social-icon:hover{transform:translateY(-3px);background:rgba(251,229,178,.16)}
  .mg-social-icon:focus-visible,.mg-social-card:focus-visible{outline:3px solid #e6bd78;outline-offset:3px}
  .mg-social-icon-unlinked{opacity:.79}
  .mg-social-footer-note{margin:0!important;font:italic 12px/1.5 Georgia,serif!important;color:#c9ceb9!important}

  .mg-social-follow{background:linear-gradient(145deg,#e6ebdf,#fcf8ef);color:#274736;border-block:1px solid #d7c49b;padding:30px 0 35px}
  .mg-social-follow-inner{width:min(1180px,93%);margin:auto;text-align:center}
  .mg-social-eyebrow{font:700 10px/1.5 Arial,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#9d7944;margin:0 0 9px}
  .mg-social-follow h2{font:400 clamp(30px,4vw,48px)/1.12 Georgia,serif;color:#254635;margin:0 0 10px}
  .mg-social-follow h2 em{color:#a67b43;font-style:italic}
  .mg-social-follow .mg-social-intro{font:15px/1.65 Arial,sans-serif;max-width:700px;color:#5a6b5c;margin:0 auto 20px}
  .mg-social-cards{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:10px;align-items:stretch}
  .mg-social-card{min-width:0;min-height:127px;width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;padding:11px 6px;color:#315241;background:#fffdf7;border:1px solid #d8c7a6;border-radius:9px;box-shadow:0 5px 14px rgba(28,50,34,.075);text-decoration:none!important;cursor:pointer;transition:transform .2s ease,box-shadow .2s ease;font-family:Arial,sans-serif}
  .mg-social-card:hover{transform:translateY(-3px);box-shadow:0 9px 19px rgba(28,50,34,.13)}
  .mg-social-card .mg-social-icon{height:62px;width:62px;padding:1px;border:0;background:transparent;box-shadow:none;border-radius:0;cursor:inherit}
  .mg-social-card strong{font:700 12px/1.35 Arial,sans-serif;color:inherit}
  .mg-social-card small{font:11px/1.3 Arial,sans-serif;color:#85755b}
  .mg-social-card-soon{background:#faf8f1}
  .mg-social-status{min-height:20px;margin:13px 0 0!important;font:13px/1.5 Arial,sans-serif!important;color:#80633f!important}

  body[data-theme='dark'] .mg-social-follow{background:linear-gradient(145deg,#1c3327,#2a4534);color:#f7ebd8;border-color:#887957}
  body[data-theme='dark'] .mg-social-follow h2{color:#fff2df}
  body[data-theme='dark'] .mg-social-follow .mg-social-intro{color:#e3e6d9}
  body[data-theme='dark'] .mg-social-card{background:#2b4636;color:#f6ead8;border-color:#8b7c59}
  body[data-theme='dark'] .mg-social-card small{color:#dfcfae}
  body[data-theme='dark'] .mg-social-card-soon{background:#233c2d}
  body[data-theme='dark'] .mg-social-status{color:#efcd97!important}

  @media(max-width:1050px){.mg-social-cards{grid-template-columns:repeat(4,minmax(0,1fr))}}
  @media(max-width:600px){
    .mg-social-follow{padding:22px 0 27px}
    .mg-social-follow .mg-social-intro{font-size:14px;margin-bottom:16px}
    .mg-social-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
    .mg-social-card{min-height:113px;padding:8px 3px}
    .mg-social-card .mg-social-icon{width:54px;height:54px}
    .mg-social-card strong{font-size:11px}
    .mg-social-footer{margin-top:12px}
    .mg-social-row{gap:7px}
    .mg-social-row .mg-social-icon{width:37px;height:37px}
  }
  @media(max-width:340px){.mg-social-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
  `;

  // A profile URL is used only if it is an explicitly configured HTTPS link.
  function safeUrl(raw) {
    if (!raw || typeof raw !== 'string') return '';
    try { const url = new URL(raw); return url.protocol === 'https:' ? url.href : ''; }
    catch (_) { return ''; }
  }
  function picture(channel) {
    const image = document.createElement('img');
    image.src = LOGO_BASE + channel.filename;
    let triedFallback = false;
    image.addEventListener('error', function(){
      if (!triedFallback) { triedFallback = true; image.src = LOGO_FALLBACK + channel.filename; }
      else { image.style.display = 'none'; }
    });
    image.alt = '';
    image.loading = 'lazy';
    image.decoding = 'async';
    return image;
  }
  function announce(channel) {
    const live = document.getElementById('mgSocialStatus');
    const message = `Our official ${channel.label} account is coming soon.`;
    if (live) live.textContent = message;
    const note = document.querySelector('.mg-social-footer-note');
    if (note) note.textContent = message;
  }
  function makeIcon(channel, cardMode) {
    const url = safeUrl(SOCIAL_URLS[channel.id]);
    const el = document.createElement(url ? 'a' : 'button');
    if (url) { el.href = url; el.target = '_blank'; el.rel = 'noopener noreferrer'; }
    else { el.type = 'button'; el.addEventListener('click', () => announce(channel)); }
    if (cardMode) {
      el.className = 'mg-social-card' + (url ? '' : ' mg-social-card-soon');
      el.setAttribute('aria-label',url ? `Visit our ${channel.label} channel` : `${channel.label}: coming soon`);
    } else {
      el.className = 'mg-social-icon' + (url ? '' : ' mg-social-icon-unlinked');
      el.setAttribute('aria-label',url ? `Open ${channel.label}` : `${channel.label}: coming soon`);
      el.title = url ? `Open ${channel.label}` : `${channel.label} — coming soon`;
    }
    if (cardMode) {
      const frame = document.createElement('span'); frame.className='mg-social-icon';
      frame.appendChild(picture(channel));el.appendChild(frame);
      const name = document.createElement('strong');name.textContent=channel.label;el.appendChild(name);
      const note = document.createElement('small');note.textContent=url?(channel.id==='whatsapp'?'Message us':'Visit account'):'Coming soon';el.appendChild(note);
    } else { el.appendChild(picture(channel)); }
    return el;
  }

  function mount(){
    if (document.getElementById('mgSocialLogoStyles')) return;
    const footer = document.querySelector('footer.site-footer');
    if (!footer) return;
    const style = document.createElement('style');style.id='mgSocialLogoStyles';style.textContent=css;document.head.appendChild(style);

    const identity = footer.querySelector('.footer-identity') || footer;
    const widget = document.createElement('div');widget.className='mg-social-footer';widget.setAttribute('aria-label','Social media channels');
    const label = document.createElement('div');label.className='mg-social-footer-label';label.textContent='Follow our heritage journey';widget.appendChild(label);
    const row = document.createElement('div');row.className='mg-social-row';CHANNELS.forEach(c=>row.appendChild(makeIcon(c,false)));widget.appendChild(row);
    const note = document.createElement('p');note.className='mg-social-footer-note';note.textContent='New official channels coming soon.';widget.appendChild(note);
    identity.appendChild(widget);

    const main = document.querySelector('main');
    const isContact = /^\/bp\/contact(?:\/|\/index\.html)?$/i.test(location.pathname) || Boolean(document.querySelector('main.contact-page'));
    if (isContact && main && !main.querySelector('.mg-social-follow')) {
      const section=document.createElement('section');section.className='mg-social-follow';section.setAttribute('aria-label','Follow the Heritage House');
      const inner=document.createElement('div');inner.className='mg-social-follow-inner';
      const eyebrow=document.createElement('p');eyebrow.className='mg-social-eyebrow';eyebrow.textContent='Connect with the Heritage House';inner.appendChild(eyebrow);
      const heading=document.createElement('h2');heading.innerHTML='Follow our <em>heritage journey.</em>';inner.appendChild(heading);
      const intro=document.createElement('p');intro.className='mg-social-intro';intro.textContent='Our social channels will launch as their official pages are established. WhatsApp is already available for direct enquiries.';inner.appendChild(intro);
      const cards=document.createElement('div');cards.className='mg-social-cards';CHANNELS.forEach(c=>cards.appendChild(makeIcon(c,true)));inner.appendChild(cards);
      const status=document.createElement('p');status.className='mg-social-status';status.id='mgSocialStatus';status.setAttribute('role','status');status.setAttribute('aria-live','polite');inner.appendChild(status);
      section.appendChild(inner);main.appendChild(section);
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded',mount,{once:true});
  else mount();
})();
